# Copy to backend/.env and fill in values.

# Gmail SMTP (enable 2FA, then create an App Password)
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
MAIL_FROM="AEROLAMINAR <your-sender@gmail.com>"
APP_ORIGIN=http://localhost:3001

# Aliases also supported:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
